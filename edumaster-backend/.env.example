# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/edumaster?schema=public"

# JWT
JWT_SECRET="super-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# API
API_PREFIX="api/v1"
PORT=4000

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Payment Providers
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""

# AI
OPENAI_API_KEY=""

# Redis (for background jobs)
REDIS_URL="redis://localhost:6379"

# Environment
NODE_ENV="development"